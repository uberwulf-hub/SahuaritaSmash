<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sahuarita Smash! SE for Windows -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SahuaritaSmashSE</AssemblyName>
    <RootNamespace>SahuaritaSmash.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\SahuaritaSmash\Assets\SahuaritaSmash.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- lets the project build on Linux too (the checks in a cloud session); the real build is on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <!-- Andrew's recorded songs (Suno, Pro plan) and their loops, next to the exe -->
    <None Include="..\..\Music\Brawl\*" Link="Music\Brawl\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SahuaritaSmash\SahuaritaSmash.csproj" />
  </ItemGroup>
</Project>
